test-data/*.dwg
test-data/*.dxf
test-data/*.ppm
test-data/MyCad-preview.*
test-data/_*.png

# Editors / OS
.idea/
.vscode/
*.swp
*.swo
*~
Thumbs.db
Desktop.ini
.DS_Store
